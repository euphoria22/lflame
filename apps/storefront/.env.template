# LAFLAMME storefront. Скопируйте в .env и заполните.

# Публичный адрес сайта (главное зеркало, ТЗ, п. 7.2)
NEXT_PUBLIC_SITE_URL=http://localhost:8000

# Medusa. Ключ витрины: админка Medusa → Настройки → Публикуемые API-ключи → «Витрина LAFLAMME»
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# CMS (Payload): откуда витрина берёт баннеры и страницы
CMS_URL=http://localhost:3001

# Сброс кэша по событию из Medusa: тот же секрет, что STOREFRONT_REVALIDATE_SECRET в бэкенде
REVALIDATE_SECRET=

# Адрес CDN/S3 с фото товаров (production)
IMAGES_CDN_URL=

# Индексация поисковиками: on только на production (ТЗ, п. 7.8)
INDEXING=off

