# LAFLAMME CMS (Payload). Скопируйте в .env и заполните.

# Адрес CMS (на production — admin-поддомен)
CMS_URL=http://localhost:3001

# Отдельная база PostgreSQL для контента
PAYLOAD_DATABASE_URL=postgres://postgres:postgres@localhost:5432/lflame_payload

# Обязательно: любая длинная случайная строка, 32+ символа.
# Сгенерировать: openssl rand -hex 32  (или просто наберите 40 случайных букв и цифр)
PAYLOAD_SECRET=

# Сброс кэша витрины после публикации статей (тот же секрет, что REVALIDATE_SECRET витрины)
STOREFRONT_URL=http://localhost:8000
STOREFRONT_REVALIDATE_SECRET=
