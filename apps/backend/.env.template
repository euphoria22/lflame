# LAFLAMME backend (Medusa). Скопируйте в .env и заполните.
# Секреты в git не коммитятся (ТЗ, п. 8.3).

# База данных PostgreSQL 16
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lflame_medusa

# Redis. Локально можно оставить пустым: тогда используются in-memory модули.
# На staging и production обязателен.
REDIS_URL=redis://localhost:6379

# CORS: адреса витрины и админки
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:8000

# Адрес бэкенда, который видит браузер админки
MEDUSA_BACKEND_URL=http://localhost:9000

# Секреты: на production сгенерировать длинные случайные строки
# (например: openssl rand -hex 32)
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
AUTH_MFA_ENCRYPTION_KEY=

# Хранилище фото (S3-совместимое, в РФ). Пусто = локальная папка static/.
S3_BUCKET=
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ru-1
S3_ENDPOINT=
