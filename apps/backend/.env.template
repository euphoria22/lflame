# LAFLAMME backend (Medusa). Скопируйте в .env и заполните.
# Секреты в git не коммитятся (ТЗ, п. 8.3).

# База данных PostgreSQL 16
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lflame_medusa
# SSL к базе — только для внешней управляемой базы (Yandex Managed PostgreSQL и т.п.)
# DATABASE_SSL=true

# Redis. Локально можно оставить пустым: тогда используются in-memory модули.
# На staging и production обязателен.
REDIS_URL=redis://localhost:6379

# CORS: адреса витрины и админки
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:8000

# Адрес бэкенда, который видит браузер админки
MEDUSA_BACKEND_URL=http://localhost:9000

# Секреты: на production сгенерировать длинные случайные строки
# (например: openssl rand -hex 32)
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
AUTH_MFA_ENCRYPTION_KEY=

# Хранилище фото (S3-совместимое, в РФ). Пусто = локальная папка static/.
S3_BUCKET=
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ru-1
S3_ENDPOINT=

# МойСклад (ТЗ, п. 3). Токен технического пользователя: только права из docs/moysklad.md.
MOYSKLAD_TOKEN=
MOYSKLAD_STORE_NAME=Основной склад (Партизанская 5а/8)
MOYSKLAD_SALE_PRICE=Цена продажи
MOYSKLAD_OLD_PRICE=Старая цена
# Секрет в адресе вебхуков МС: openssl rand -hex 24
MOYSKLAD_WEBHOOK_SECRET=
# Синхронизация по расписанию (каталог раз в 30 минут, остатки раз в 10 минут)
MOYSKLAD_SCHEDULE_ENABLED=false

# Витрина: сброс кэша при изменении каталога (ТЗ, п. 7.1). Секрет совпадает с витриной.
STOREFRONT_URL=http://localhost:8000
STOREFRONT_REVALIDATE_SECRET=

# Выгрузка заказов сайта в МойСклад (ТЗ, п. 3.4). Включать только на production
# или для согласованного тестового заказа: заказы попадают в настоящий МойСклад.
MOYSKLAD_ORDERS_ENABLED=false

# СДЭК (ТЗ, п. 5). Тестовая среда: https://api.edu.cdek.ru/v2 и общедоступный тестовый аккаунт
# из документации СДЭК. Боевая: https://api.cdek.ru/v2 и ключи из ЛК СДЭК → Интеграция.
CDEK_API_URL=https://api.edu.cdek.ru/v2
# Пусто + тестовый адрес (api.edu.cdek.ru) = общедоступный тестовый аккаунт СДЭК. Для боевого — ключи из кабинета СДЭК
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# Код города отправителя (Омск = 268)
CDEK_FROM_CITY_CODE=268
# Пункт СДЭК, куда магазин сдаёт посылки, по умолчанию (меняется в админке). OMS6 — ул. Гагарина, 8/2
CDEK_SHIPMENT_POINT=OMS6
# Бесплатная доставка от суммы товаров, ₽ — значение по умолчанию; меняется в админке «Доставка и оплата»
FREE_SHIPPING_FROM=12000

# Почта России: индекс отделения отправки (для расчёта стоимости)
POCHTA_FROM_INDEX=644007
# Отделения Почты на карте — API «Отправка» (otpravka.pochta.ru → Настройки → Токен авторизации).
# Пусто — покупатель вводит индекс вручную.
POCHTA_TOKEN=
POCHTA_LOGIN=
POCHTA_PASSWORD=

# --- Т-Касса (онлайн-оплата картой и СБП) ---
# Терминал и пароль — личный кабинет Т-Бизнес → Интернет-эквайринг → Магазины → Терминалы.
# Тестовый терминал оканчивается на DEMO. Пустые значения — оплата онлайн на сайте скрыта.
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_API_URL=https://securepay.tinkoff.ru/v2
# Система налогообложения для чеков 54-ФЗ (osn, usn_income, usn_income_outcome, esn, patent).
# Пусто — чеки через Т-Кассу не передаются (если чеки бьёт МойСклад/своя касса).
TBANK_TAXATION=
# Уведомления об оплате приходят на MEDUSA_BACKEND_URL/hooks/payment/tbank_tbank — на сервере это должен быть адрес из интернета

# --- Письма (ТЗ, п. 6.6) ---
# SMTP почтового сервиса (Яндекс 360, Unisender Go, Mail.ru для бизнеса). Пусто — письма печатаются в журнал сервера.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# От кого письма, например: LAFLAMME <shop@laflamme.ru>
MAIL_FROM=
# Куда присылать уведомления о новых заказах (можно оставить пустым)
SHOP_EMAIL=

# --- Telegram: уведомления магазину о новых заказах ---
# Бот: @BotFather -> токен. Чат: добавьте бота в группу/канал, узнайте chat_id (например, через @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
