# LAFLAMME production — ключи интеграций Medusa. Скопируйте в infra/.env.backend и заполните.
# Адреса, база, Redis и основные секреты задаются в infra/.env (docker-compose.prod.yml).

# Фото товаров: S3-совместимое хранилище в РФ (Yandex Object Storage, Selectel, VK Cloud)
S3_BUCKET=
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ru-central1
S3_ENDPOINT=

# МойСклад
MOYSKLAD_TOKEN=
MOYSKLAD_STORE_NAME=Основной склад (Партизанская 5а/8)
MOYSKLAD_SALE_PRICE=Цена продажи
MOYSKLAD_OLD_PRICE=Старая цена
MOYSKLAD_WEBHOOK_SECRET=
MOYSKLAD_SCHEDULE_ENABLED=true
MOYSKLAD_ORDERS_ENABLED=false

# СДЭК (боевые ключи из ЛК СДЭК → Интеграция)
CDEK_API_URL=https://api.cdek.ru/v2
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_FROM_CITY_CODE=268
CDEK_SHIPMENT_POINT=OMS6
# Секрет в адресе вебхука СДЭК (необязательно): openssl rand -hex 24
CDEK_WEBHOOK_SECRET=

# Почта России: индекс отправителя и ключи API «Отправка» (для отделений на карте)
POCHTA_FROM_INDEX=644007
POCHTA_TOKEN=
POCHTA_LOGIN=
POCHTA_PASSWORD=

# Т-Банк (боевой терминал)
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_API_URL=https://securepay.tinkoff.ru/v2
TBANK_TAXATION=

# Почта для писем покупателям (SMTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Laflamme <admin@laflamme.ru>
# Куда магазину приходят копии/уведомления
SHOP_EMAIL=admin@laflamme.ru

# Telegram: уведомления о заказах магазину
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ключ шифрования двухфакторного входа админов: openssl rand -hex 32
AUTH_MFA_ENCRYPTION_KEY=

# Бесплатная доставка от суммы, ₽ (меняется в админке)
FREE_SHIPPING_FROM=12000
