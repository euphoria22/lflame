# LAFLAMME production — общие настройки сервера. Скопируйте в infra/.env и заполните.
# Секреты: openssl rand -hex 32. Файл infra/.env в git не попадает.

# Домены (DNS: A-записи всех трёх и www — на IP сервера)
SITE_DOMAIN=laflamme.ru
ADMIN_DOMAIN=admin.laflamme.ru
CMS_DOMAIN=cms.laflamme.ru
# Почта для уведомлений Let's Encrypt о сертификатах
ACME_EMAIL=admin@laflamme.ru
# IP, с которых открываются админки (через пробел; ваш офис/дом/VPN). Узнать свой: https://2ip.ru
ADMIN_ALLOW_IPS=127.0.0.1

# База данных
POSTGRES_USER=lflame
POSTGRES_PASSWORD=

# Секреты приложения
JWT_SECRET=
COOKIE_SECRET=
PAYLOAD_SECRET=
REVALIDATE_SECRET=

# Ключ витрины: админка Medusa → Настройки → Publishable API keys (после первого запуска)
MEDUSA_PUBLISHABLE_KEY=

# Фото товаров в S3 (публичный адрес бакета/CDN), Яндекс Метрика (номер счётчика)
IMAGES_CDN_URL=
YM_ID=

# Индексация поисковиками: on — только когда сайт готов к запуску
INDEXING=off

# Бэкапы (infra/scripts/backup.sh): пароль шифрования — хранить ещё и отдельно от сервера!
BACKUP_PASSPHRASE=
# Хранилище у другого провайдера в формате rclone, например yandex:lflame-backups (rclone config)
BACKUP_REMOTE=
# …или проще — S3-хранилище другого провайдера (Beget, Selectel, Timeweb): тогда BACKUP_REMOTE не нужен.
# Ключи — через bash infra/scripts/set-secret.sh BACKUP_S3_ACCESS_KEY infra/.env (и BACKUP_S3_SECRET_KEY)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=ru-1
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# Размер сетевого пакета Docker (MTU): как у сетевой карты сервера — команда «ip link», строка ens3/eth0
DOCKER_MTU=1450
